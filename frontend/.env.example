# Base path (or absolute URL) the browser uses to reach the Testlab backend.
# Defaults to /api, which the Vite dev server proxies to TESTLAB_BACKEND_URL.
VITE_API_BASE_URL=/api

# Where the dev proxy forwards /api requests. Not exposed to the browser.
TESTLAB_BACKEND_URL=http://localhost:8080

# DEV ONLY: a Testlab JWT to send as a Bearer token while the browser login
# hand-off is being finalised. Ignored in production builds.
# VITE_DEV_TOKEN=
