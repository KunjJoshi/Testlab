DB_PASSWORD=
DATABASE_URL=postgresql://<DB_LINK>
GITHUB_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_REDIRECT_URL=http://localhost:8080/auth/github/callback
JWT_SECRET=
ISSUER_URL=http://localhost:8080

# Where the browser app lives. Users are redirected here after GitHub login.
FRONTEND_URL=http://localhost:5173
# Comma-separated origins allowed to call the API from a browser (defaults to FRONTEND_URL).
# Only needed when the frontend is not served from the same origin as the API.
ALLOWED_ORIGINS=
# Session cookie Secure flag. Defaults to true when FRONTEND_URL is https.
COOKIE_SECURE=
